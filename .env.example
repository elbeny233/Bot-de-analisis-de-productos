RADAR_APP_NAME="Radar Ofertas VIP"
RADAR_DATABASE_URL="sqlite:///./data/radar.db"
RADAR_MONITOR_INTERVAL_MINUTES=30
RADAR_SCHEDULER_ENABLED=true
RADAR_MONITOR_MAX_ATTEMPTS=3
RADAR_MONITOR_RETRY_SECONDS=1
RADAR_MONITOR_PAUSE_AFTER_FAILURES=3
RADAR_PUBLICATIONS_ENABLED=false
RADAR_LOG_LEVEL=INFO

# Análisis: no conviertas un historial de minutos en un descuento confirmado.
RADAR_ANALYSIS_REFERENCE_DAYS=30
RADAR_ANALYSIS_MIN_OBSERVATIONS=5
RADAR_ANALYSIS_MIN_HISTORY_DAYS=7
RADAR_ANALYSIS_MIN_DISTINCT_DAYS=3
RADAR_ANALYSIS_MAX_AGE_HOURS=24
RADAR_ANALYSIS_MIN_DISCOUNT_PERCENT=10
RADAR_ANALYSIS_MIN_SCORE=70
RADAR_ANALYSIS_MIN_IDENTITY_CONFIDENCE=0.8
